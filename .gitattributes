# Normalize line endings by default
* text=auto

# Windows scripts
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix scripts must keep LF
*.sh text eol=lf

# Config / source
*.lua text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.ttf binary
*.otf binary
*.zip binary

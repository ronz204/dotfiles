{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:dim",
          "background": "transparent",
          "template": "╭─ "
        },
        {
          "type": "path",
          "style": "diamond",
          "foreground": "p:blue",
          "background": "p:surface",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": "  {{ path .Path .Location }} ",
          "options": {
            "style": "full",
            "folder_separator_icon": "/"
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "foreground": "p:text",
          "background": "p:surface",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "template": " <p:violet></> <b>{{ .HEAD }}</b>{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Modified }} <p:orange>~{{ .Working.Modified }}</>{{ end }}{{ if .Working.Untracked }} <p:cyan>?{{ .Working.Untracked }}</>{{ end }}{{ if .Staging.Changed }} <p:green>{{ .Staging.String }}</>{{ end }} ",
          "options": {
            "branch_icon": "",
            "branch_template": "{{ trunc 25 .Branch }}"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:dim",
          "background": "transparent",
          "template": "node <p:green>v{{ .Major }}.{{ .Minor }}</> ",
          "options": {
            "fetch_package_manager": false
          }
        },
        {
          "type": "bun",
          "style": "plain",
          "foreground": "p:dim",
          "background": "transparent",
          "template": "bun <p:orange>{{ .Major }}.{{ .Minor }}</> "
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:dim",
          "background": "transparent",
          "template": "{{ .CurrentDate | date \"15:04\" }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:dim",
          "background": "transparent",
          "template": "╰─ ❯❯{{ if gt .Code 0 }}<p:red>❯</>{{ else }}<p:green>❯</>{{ end }}",
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ],
  "tooltips": [
    {
      "type": "aws",
      "tips": [
        "aws"
      ],
      "style": "diamond",
      "foreground": "p:orange",
      "background": "p:surface",
      "leading_diamond": "",
      "trailing_diamond": "",
      "template": "  {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
      "options": {
        "display_default": true
      }
    },
    {
      "type": "az",
      "tips": [
        "az"
      ],
      "style": "diamond",
      "foreground": "p:blue",
      "background": "p:surface",
      "leading_diamond": "",
      "trailing_diamond": "",
      "template": "  {{ .Name }} "
    }
  ],
  "secondary_prompt": {
    "foreground": "p:dim",
    "background": "transparent",
    "template": "❯ "
  },
  "palette": {
    "base": "#1A1B26",
    "surface": "#24283B",
    "text": "#C0CAF5",
    "dim": "#565F89",
    "blue": "#7AA2F7",
    "cyan": "#7DCFFF",
    "green": "#9ECE6A",
    "orange": "#FF9E64",
    "red": "#F7768E",
    "violet": "#BB9AF7"
  }
}

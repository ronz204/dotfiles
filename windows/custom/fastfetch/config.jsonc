{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/src/dotfiles/windows/custom/fastfetch/moon.txt",
    "padding": { "left": 2, "right": 3, "top": 1 }
  },
  "display": {
    "separator": "  •  ",
    "color": { "separator": "38;2;86;95;137" }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": " \u001b[1;38;2;255;158;100mronz\u001b[0m \u001b[38;2;86;95;137m@\u001b[0m \u001b[1;38;2;122;162;247mtokyo\u001b[0m"
    },
    {
      "type": "custom",
      "format": " \u001b[38;2;247;118;142m●\u001b[38;2;255;158;100m ●\u001b[38;2;224;175;104m ●\u001b[38;2;158;206;106m ●\u001b[38;2;115;218;202m ●\u001b[38;2;125;207;255m ●\u001b[38;2;122;162;247m ●\u001b[38;2;187;154;247m ●\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;86;95;137m ┌─── System Info ───────────────────────────────────────────┐"
    },
    { "type": "os",       "key": "    OS        ", "keyColor": "38;2;247;118;142" },
    { "type": "shell",    "key": "    Shell     ", "keyColor": "38;2;255;158;100" },
    { "type": "terminal", "key": "    Terminal  ", "keyColor": "38;2;125;207;255" },
    { "type": "packages", "key": "    Packages  ", "keyColor": "38;2;187;154;247" },
    { "type": "cpu",      "key": "    CPU       ", "keyColor": "38;2;255;158;100", "format": "{name}" },
    { "type": "gpu",      "key": "    GPU       ", "keyColor": "38;2;158;206;106", "format": "{name}", "hideType": "integrated" },
    { "type": "display",  "key": "    Display   ", "keyColor": "38;2;122;162;247", "compactType": "original-with-refresh-rate" },
    { "type": "uptime",   "key": "    Uptime    ", "keyColor": "38;2;247;118;142" },
    {
      "type": "custom",
      "format": "\u001b[38;2;86;95;137m └───────────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
